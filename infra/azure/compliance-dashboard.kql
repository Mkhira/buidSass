// E1 Phase 9 (T072). Saved Log Analytics KQL queries that power the daily compliance
// dashboard, pinned to the on-call team's home page.
//
// Five panels (a–e per tasks.md T072) + one helper join (f) added by Phase B review:
//   a. Deploy success rate over 7 days
//   b. Median deploy duration
//   c. Audit-completeness gap count (unpaired deploy.attempted in past 7 days)
//   d. Drift events count (past 7 days)
//   e. Alert fire count by category
//   f. AC-12 triage — Officer/Administrator assignments minus PIM-active rows
//
// Source assumption: `AuditEvents_CL` is the Log Analytics custom table fed by a
// `audit_log_entries` → DCR forwarder (one row per emitted event). Every emitted row
// carries `EventType_s`, `Payload_s` (JSON), and `CorrelationId_g`. The forwarder is
// part of T012's Log Analytics workspace bring-up; the Postgres table is the
// system-of-record and Log Analytics is the queryable mirror with 7-day retention.
//
// File format: each panel is a self-contained KQL query, separated by
// `// === panel <id> ===` banner comments. Azure Workbook pulls one panel per tile.

// === panel a — deploy success rate (past 7 days) ===
AuditEvents_CL
| where TimeGenerated > ago(7d)
| where EventType_s startswith "deploy.completed_"
| summarize
    Succeeded = countif(EventType_s == "deploy.completed_succeeded"),
    Failed    = countif(EventType_s == "deploy.completed_failed"),
    Total     = count()
| extend SuccessRatePct = round(100.0 * Succeeded / iff(Total == 0, 1, Total), 2)

// === panel b — median deploy duration (past 7 days) ===
let attempted =
    AuditEvents_CL
    | where TimeGenerated > ago(7d)
    | where EventType_s == "deploy.attempted"
    | project CorrelationId_g, AttemptedAt = TimeGenerated;
let completed =
    AuditEvents_CL
    | where TimeGenerated > ago(7d)
    | where EventType_s startswith "deploy.completed_"
    | project CorrelationId_g, CompletedAt = TimeGenerated;
attempted
| join kind=inner completed on CorrelationId_g
| extend DurationSeconds = datetime_diff('second', CompletedAt, AttemptedAt)
| summarize MedianDurationSeconds = percentile(DurationSeconds, 50)

// === panel c — audit-completeness gap count (past 7 days) ===
// Any `deploy.attempted` without a paired `deploy.completed_*` within 30 minutes.
let attempted =
    AuditEvents_CL
    | where TimeGenerated > ago(7d)
    | where EventType_s == "deploy.attempted"
    | project CorrelationId_g, AttemptedAt = TimeGenerated;
let completed =
    AuditEvents_CL
    | where TimeGenerated > ago(7d)
    | where EventType_s startswith "deploy.completed_"
    | project CorrelationId_g, CompletedAt = TimeGenerated;
attempted
| join kind=leftouter completed on CorrelationId_g
| where isnull(CompletedAt) or datetime_diff('minute', CompletedAt, AttemptedAt) > 30
| summarize GapCount = count()

// === panel d — drift events (past 7 days) ===
AuditEvents_CL
| where TimeGenerated > ago(7d)
| where EventType_s == "infra.drift.detected"
| extend Payload = parse_json(Payload_s)
| extend Environment = tostring(Payload.environment)
| summarize Count = count() by Environment
| order by Count desc

// === panel e — alert fire count by category (past 7 days) ===
AzureActivity
| where TimeGenerated > ago(7d)
| where OperationNameValue == "Microsoft.AlertsManagement/alerts/state/changedTo/fired/action"
| extend AlertName = tostring(parse_json(Properties).alertRuleName)
| extend Category = case(
    AlertName startswith "alert-deploy-failure-",  "deploy-failure",
    AlertName startswith "alert-health-probe-",    "health-probe",
    AlertName startswith "alert-high-5xx-",        "high-5xx",
    AlertName startswith "alert-kv-anomaly-",      "kv-anomaly",
    "other")
| summarize Count = count() by Category
| order by Count desc

// === panel f — AC-12 candidates (KV Officer/Administrator assignments to triage) ===
// Lists every NonCompliant row from `e1-kv-privileged-audit-<env>-asg`. Each row
// is a *candidate* permanent grant; the PIM-active filter happens MANUALLY in the
// runbook §AC-12 violation triage procedure because:
//   - Azure Resource Graph does not reliably surface
//     `microsoft.authorization/roleAssignmentSchedules` in the
//     AuthorizationResources table (per CodeRabbit Loop 2 research on PR #84
//     citing Microsoft docs).
//   - The ARM `roleAssignmentSchedules` REST endpoint correlates to
//     `roleAssignments` only by the (scope, principalId, roleDefinitionId)
//     triple — there is no first-class join key, so any KQL-side join would
//     misbehave.
// On-call therefore runs the `az`-based cross-check documented in the runbook
// against each row in this panel. False positives (active PIM activations) get
// filtered there; the residue is the AC-12 actionable set.
PolicyResources
| where type == "microsoft.policyinsights/policystates"
| where properties.policyAssignmentName startswith "e1-kv-privileged-audit-"
| where properties.complianceState == "NonCompliant"
| extend RoleAssignmentId = tostring(properties.resourceId)
| extend PrincipalId = tostring(properties.principalId)
| extend RoleDefinitionId = tostring(properties.policyDefinitionReferenceId)
| extend ViolationTimestamp = tostring(properties.timestamp)
| project RoleAssignmentId, PrincipalId, RoleDefinitionId, ViolationTimestamp
| order by ViolationTimestamp desc
